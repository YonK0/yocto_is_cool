sudo mkdir -p /tmp/rootA
sudo mkdir -p /tmp/rootB

sudo mount /dev/mmcblk0p2 /tmp/rootA
sudo mount /dev/mmcblk0p3 /tmp/rootB


sudo rm -f /tmp/rootA/home/root/mybundle-*.raucb
sudo rm -f /tmp/rootB/home/root/mybundle-*.raucb

echo "Removing old file in both partitions"
sudo  cp /home/g701943/workspace/yocto_is_cool/build/tmp/deploy/images/pizero/mybundle-pizero-*.raucb /tmp/rootA/home/root/
sync
umount /tmp/rootA
echo "Done copying bundle to rootA"

sudo  cp /home/g701943/workspace/yocto_is_cool/build/tmp/deploy/images/pizero/mybundle-pizero-*.raucb /tmp/rootB/home/root/
sync
umount /tmp/rootB
echo "Done copying bundle to rootB"

exit