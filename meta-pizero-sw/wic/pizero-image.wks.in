# meta-pizero SD image (wic). This is a .wks.in so ${IMAGE_LINK_NAME} expands.


part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096 --size 400
part / --source rawcopy --sourceparams="file=${IMGDEPLOYDIR}/${IMAGE_LINK_NAME}.ext4.verity" --ondisk mmcblk0 --fstype=ext4 --align 4096 --size ${ROOTFS_SLOT_SIZE}
part / --source rawcopy --sourceparams="file=${IMGDEPLOYDIR}/${IMAGE_LINK_NAME}.ext4.verity" --ondisk mmcblk0 --fstype=ext4 --align 4096 --size ${ROOTFS_SLOT_SIZE}
part /data --ondisk mmcblk0 --fstype=ext4 --label data --align 4096 --size 80
